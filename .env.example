# Local / compose: copy to .env in the repo.
# Quadlet on Bazzite: put the same keys in
#   ~/.config/coolhurst-booker/coolhurst-booker.env  (mode 600)
# and reference it via EnvironmentFile — never commit that file.
# In the container, use COOLHURST_DB_PATH=/data/courts.db

COOLHURST_USERNAME=
COOLHURST_PASSWORD=
COOLHURST_BASE_URL=https://coolhurst.clubsolution.co.uk/newlook
COOLHURST_BOOKING_AREA=Outdoor Tennis
COOLHURST_DAYS_AHEAD=14
COOLHURST_DB_PATH=./data/courts.db
COOLHURST_BOOK_URL=https://coolhurst.clubsolution.co.uk/newlook/proc_baner.asp
PLAYWRIGHT_HEADLESS=true
SCRAPE_INTERVAL_SECONDS=300

BOOKER_NAME=Roshan
GOOGLE_APPOINTMENT_URL=https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1UyZ4YQe7yyIkB-Cy9BKUym6-10oCEzUgur_8dU9-zC6t0Qv50TcAZAs-D9oWZq4hc1jefxdKX
# Optional — only if the public booking page requires Google login
GOOGLE_USERNAME=
GOOGLE_PASSWORD=
